{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.10/dab.draft.schema.json",

  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('SQL_CONNECTION_STRING')",
    "options": {
      "set-session-context": false
    }
  },

  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": false
    },

    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },

    "mcp": {
      "enabled": true,
      "path": "/mcp"
    },

    "host": {
      "cors": {
        "origins": [
          "http://localhost:8080"
        ],
        "allow-credentials": false
      },

      "authentication": {
        "provider": "EntraID",
        "jwt": {
          "audience": "a60ed98d-918e-4f1b-b674-4e21bdbb2945",
          "issuer": "https://login.microsoftonline.com/9ba0415e-abad-465a-a0b9-13194357cce3/v2.0"
        }
      },

      "mode": "development"
    }
  },

  "entities": {
    "Users": {
      "source": {
        "object": "dbo.Users",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "User",
          "plural": "Users"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "TaskManagement.User",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ]
    },

    "Tasks": {
      "source": {
        "object": "dbo.Tasks",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Task",
          "plural": "Tasks"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "TaskManagement.User",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ]
    },

    "Comments": {
      "source": {
        "object": "dbo.Comments",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Comment",
          "plural": "Comments"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "TaskManagement.User",
          "actions": [
            {
              "action": "*"
            }
          ]
        }
      ]
    }
  }
}