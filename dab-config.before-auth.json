{
    "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.10/dab.draft.schema.json",
    "data-source": {
        "database-type": "mssql",
        "connection-string": "@env('SQL_CONNECTION_STRING')",
        "options": {
            "set-session-context": false
        }
    },
    "runtime": {
        "rest": {
            "enabled": true,
            "path": "/api",
            "request-body-strict": false
        },
        "graphql": {
            "enabled": true,
            "path": "/graphql",
            "allow-introspection": true
        },
        "mcp": {
            "enabled": true,
            "path": "/mcp"
        },
        "host": {
            "cors": {
                "origins": [
                    "http://localhost:8080"
                ],
                "allow-credentials": false
            },
            "authentication": {
                "provider": "StaticWebApps"
            },
            "mode": "development"
        },
        "telemetry": {
            "open-telemetry": {
                "enabled": true,
                "endpoint": "@env('OTEL_EXPORTER_OTLP_ENDPOINT')",
                "headers": "@env('OTEL_EXPORTER_OTLP_HEADERS')",
                "service-name": "@env('OTEL_SERVICE_NAME')"
            }
        }
    },
    "autoentities": {},
    "entities": {
        "Users": {
            "source": {
                "object": "dbo.Users",
                "type": "table"
            },
            "graphql": {
                "enabled": true,
                "type": {
                    "singular": "User",
                    "plural": "Users"
                }
            },
            "rest": {
                "enabled": true
            },
            "relationships": {
                "Tasks": {
                    "cardinality": "many",
                    "target.entity": "Tasks",
                    "source.fields": [
                        "Id"
                    ],
                    "target.fields": [
                        "UserId"
                    ]
                },
                "Comments": {
                    "cardinality": "many",
                    "target.entity": "Comments",
                    "source.fields": [
                        "Id"
                    ],
                    "target.fields": [
                        "UserId"
                    ]
                }
            },
            "permissions": [
                {
                    "role": "anonymous",
                    "actions": [
                        {
                            "action": "*"
                        }
                    ]
                }
            ]
        },
        "Tasks": {
            "source": {
                "object": "dbo.Tasks",
                "type": "table"
            },
            "graphql": {
                "enabled": true,
                "type": {
                    "singular": "Task",
                    "plural": "Tasks"
                }
            },
            "rest": {
                "enabled": true
            },
            "relationships": {
                "User": {
                    "cardinality": "one",
                    "target.entity": "Users",
                    "source.fields": [
                        "UserId"
                    ],
                    "target.fields": [
                        "Id"
                    ]
                },
                "Comments": {
                    "cardinality": "many",
                    "target.entity": "Comments",
                    "source.fields": [
                        "Id"
                    ],
                    "target.fields": [
                        "TaskId"
                    ]
                }
            },
            "permissions": [
                {
                    "role": "anonymous",
                    "actions": [
                        {
                            "action": "*"
                        }
                    ]
                }
            ]
        },
        "Comments": {
            "source": {
                "object": "dbo.Comments",
                "type": "table"
            },
            "graphql": {
                "enabled": true,
                "type": {
                    "singular": "Comment",
                    "plural": "Comments"
                }
            },
            "rest": {
                "enabled": true
            },
            "relationships": {
                "Task": {
                    "cardinality": "one",
                    "target.entity": "Tasks",
                    "source.fields": [
                        "TaskId"
                    ],
                    "target.fields": [
                        "Id"
                    ]
                },
                "User": {
                    "cardinality": "one",
                    "target.entity": "Users",
                    "source.fields": [
                        "UserId"
                    ],
                    "target.fields": [
                        "Id"
                    ]
                }
            },
            "permissions": [
                {
                    "role": "anonymous",
                    "actions": [
                        {
                            "action": "*"
                        }
                    ]
                }
            ]
        }
    }
}